# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized
*.js      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.jsx     text eol=lf
*.tsx     text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.txt     text eol=lf
*.env     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.svg     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.pdf     binary
*.zip     binary
